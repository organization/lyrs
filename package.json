{
  "name": "lyrs",
  "version": "0.26.4",
  "description": "Lyrs is a lyric viewer for YouTube Music / Spotify.",
  "keywords": [
    "lyric",
    "spotify",
    "youtube-music"
  ],
  "license": "Apache-2.0",
  "author": "Su-Yong <simssy2205@gmail.com>",
  "contributors": [
    "JellyBrick <shlee1503@naver.com>",
    "SeongMin Park <smn@duck.com>",
    "nenw <khi@nenw.dev>",
    "alvin0319 <alvin7810@naver.com>",
    "STGR <scgtdy7151@gmail.com>"
  ],
  "main": "./dist/main/index.mjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "clean": "del-cli dist pack",
    "build": "electron-vite build",
    "dist": "npm run clean && npm run build && electron-builder -p never",
    "dist:all": "npm run clean && npm run build && electron-builder --win --mac --linux -p never",
    "dist:mac": "npm run clean && npm run build && electron-builder --mac dmg:x64 -p never",
    "dist:mac:arm64": "npm run clean && npm run build && electron-builder --mac dmg:arm64 -p never",
    "dist:win": "npm run clean && npm run build && electron-builder --win -p never",
    "dist:win:x64": "npm run clean && npm run build && electron-builder --win nsis-web:x64 -p never",
    "dist:linux": "npm run clean && npm run build && electron-builder --linux -p never",
    "dist:linux:deb:arm64": "npm run clean && npm run build && electron-builder --linux deb:arm64 -p never",
    "release:mac": "npm run clean && npm run build && electron-builder --mac -p always",
    "release:win": "npm run clean && npm run build && electron-builder --win -p always",
    "release:linux": "npm run clean && npm run build && electron-builder --linux -p always -c.snap.publish=github",
    "dist:only": "electron-builder",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-sass": "6.0.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@floating-ui/dom": "1.8.0",
    "@hono/node-server": "2.0.10",
    "@jellybrick/glasstron": "0.2.1",
    "@jellybrick/solid-i18next": "1.2.2",
    "@solid-codemirror/codemirror": "1.0.4",
    "@solidjs/router": "0.16.1",
    "@suyongs/solid-utility": "0.4.4",
    "@uiw/codemirror-theme-github": "4.25.11",
    "codemirror": "6.0.2",
    "color": "5.0.3",
    "deepmerge-ts": "7.1.5",
    "electron-progressbar": "2.2.1",
    "electron-updater": "6.8.9",
    "font-list": "2.1.0",
    "hono": "4.12.31",
    "html-parse-string": "0.0.9",
    "i18next": "26.3.6",
    "node-forge": "1.4.0",
    "semver": "7.8.5",
    "solid-floating-ui": "0.3.1",
    "solid-js": "1.9.14",
    "solid-transition-group": "0.3.0",
    "stylis": "4.4.0",
    "supports-color": "10.2.2",
    "tstl": "3.0.0",
    "ws": "8.21.1",
    "zip-lib": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/runtime": "8.0.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/color": "4.2.1",
    "@types/electron-progressbar": "2.2.0",
    "@types/node": "26.1.1",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.2.17",
    "@types/semver": "7.7.1",
    "@types/stylis": "4.2.7",
    "@types/ws": "8.18.1",
    "bufferutil": "4.1.0",
    "del-cli": "7.0.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-solid": "0.14.5",
    "node-abi": "4.33.0",
    "node-addon-api": "8.9.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.24.0",
    "patch-package": "8.0.1",
    "tailwindcss": "4.3.3",
    "type-fest": "5.8.0",
    "typescript": "6.0.3",
    "utf-8-validate": "6.0.6",
    "vite": "8.1.5",
    "vite-plugin-solid": "2.11.13"
  },
  "optionalDependencies": {
    "@asdf-overlay/core": "1.2.5",
    "@jellybrick/wql-process-monitor": "3.0.0",
    "extract-file-icon": "0.3.2",
    "hmc-win32": "1.4.92",
    "mica-electron": "1.5.17"
  },
  "overrides": {
    "@electron/get": "5.0.0",
    "axios": "1.18.1",
    "electron": "43.1.1",
    "http-errors": "2.0.1",
    "node-abi": "4.33.0",
    "simple-update-notifier": "2.0.0",
    "xml2js": "0.6.2"
  },
  "allowScripts": {
    "bufferutil@4.1.0": true,
    "core-js@3.49.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "extract-file-icon@0.3.2": true,
    "glasstron@0.1.1": true,
    "unrs-resolver@1.12.2": true,
    "utf-8-validate@6.0.6": true,
    "fsevents@2.3.3": true
  },
  "build": {
    "productName": "Lyrs",
    "asar": true,
    "appId": "me.suyong.lyrs",
    "extends": null,
    "electronLanguages": [
      "ko",
      "en-US",
      "en-GB",
      "ja",
      "de"
    ],
    "files": [
      "dist",
      "!node_modules",
      "node_modules/debug/**",
      "node_modules/ms/**",
      "node_modules/@jellybrick/wql-process-monitor/**",
      "node_modules/@asdf-overlay/core/**",
      "node_modules/hmc-win32/**",
      "node_modules/mica-electron/**",
      "node_modules/@jellybrick/glasstron/package.json",
      "node_modules/@jellybrick/glasstron/dist/**",
      "node_modules/@jellybrick/glasstron/lib/**",
      "!node_modules/@jellybrick/glasstron/node_modules",
      "node_modules/extract-file-icon/package.json",
      "node_modules/extract-file-icon/dist/index.js",
      "node_modules/extract-file-icon/build/Release/addon.node",
      "node_modules/font-list/**"
    ],
    "extraResources": [
      "./assets/**"
    ],
    "mac": {
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music"
    },
    "dmg": {
      "title": "Lyrs",
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "assets/icon256.ico",
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    },
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github"
    },
    "linux": {
      "icon": "assets/icon256.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "freebsd",
        "deb",
        "rpm"
      ]
    },
    "directories": {
      "buildResources": "./build",
      "output": "./pack/",
      "app": "."
    }
  }
}
